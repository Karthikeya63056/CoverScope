# Copy to .env for local development. Never commit .env.

# Document-size guard. Measured sample maximum: 188,927 extracted chars.
COVERSCOPE_MAX_EXTRACTED_CHARS=250000
# Cheap upload guard in bytes; the extracted-character limit remains authoritative.
COVERSCOPE_MAX_UPLOAD_BYTES=20000000
COVERSCOPE_CHUNK_CHARS=1800
COVERSCOPE_MIN_PAGE_CHARS=40

# Retrieval
COVERSCOPE_RETRIEVAL_TOP_K=5

# Explicit manual-review pages, e.g. 50,51 or 50-52.
# Leave empty to rely only on extraction diagnostics.
COVERSCOPE_UNRELIABLE_PAGES=

# Groq
GROQ_API_KEY=
COVERSCOPE_GROQ_MODEL=openai/gpt-oss-120b
COVERSCOPE_GROQ_TIMEOUT_SECONDS=30

COVERSCOPE_GROQ_MAX_COMPLETION_TOKENS=1200

# MongoDB Atlas Integration (Optional - leave blank for in-memory session mode)
# Paste your connection URI from MongoDB Atlas Database Deployment -> Connect -> Drivers:
MONGODB_URI=
MONGODB_DATABASE=coverscope

# Authentication
# In production, set a long random secret. If unset, a random per-process
# secret is generated and sessions are invalidated on restart.
COVERSCOPE_JWT_SECRET=
# Optional administrator account. Both values must be set to enable it.
COVERSCOPE_ADMIN_EMAIL=
COVERSCOPE_ADMIN_PASSWORD=

# CORS Configuration
# Comma-separated list of exact allowed frontend origins (no trailing slashes, no wildcards).
# Localhost dev origins (http://localhost:5173, http://127.0.0.1:5173, etc.) are allowed by default.
# Example for production: https://coverscope.vercel.app,https://app.yourdomain.com
COVERSCOPE_ALLOWED_ORIGINS=
